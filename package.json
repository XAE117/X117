{
  "name": "sixpm",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scrape": "node --env-file-if-exists=.env scripts/scrape.js",
    "scrape:jazz": "node --env-file-if-exists=.env scripts/scrape-jazz.js",
    "scrape:eats": "node --env-file-if-exists=.env scripts/scrape-restaurants.js",
    "scrape:eats:hot": "node --env-file-if-exists=.env scripts/scrape-restaurants.js --hot",
    "scrape:all": "node --env-file-if-exists=.env scripts/scrape.js && node --env-file-if-exists=.env scripts/scrape-jazz.js && node --env-file-if-exists=.env scripts/scrape-restaurants.js",
    "validate": "node scripts/validate-data.js",
    "notify": "node scripts/notify.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit-dependencies.js",
    "check": "npm run lint && npm run test && npm run build && npm run audit",
    "release:check": "npm run check && npm run test:e2e && node scripts/validate-data.js --strict"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "puppeteer": "^25.8.0",
    "twilio": "^5.12.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
