{
  "name": "sixpm",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ios": "vite --mode ios",
    "build": "vite build",
    "build:ios": "vite build --mode ios && node scripts/prepare-ios-capacitor-assets.js && node scripts/check-ios-bundle.js",
    "preview": "vite preview",
    "preview:ios": "vite preview --outDir dist-ios",
    "scrape": "node --env-file-if-exists=.env scripts/scrape.js",
    "scrape:jazz": "node --env-file-if-exists=.env scripts/scrape-jazz.js",
    "scrape:eats": "node --env-file-if-exists=.env scripts/scrape-restaurants.js",
    "scrape:eats:hot": "node --env-file-if-exists=.env scripts/scrape-restaurants.js --hot",
    "scrape:all": "node --env-file-if-exists=.env scripts/scrape.js && node --env-file-if-exists=.env scripts/scrape-jazz.js && node --env-file-if-exists=.env scripts/scrape-restaurants.js && node scripts/build-ios-catalog.js",
    "catalog:build": "node scripts/build-ios-catalog.js",
    "catalog:validate": "node scripts/validate-ios-catalog.js",
    "catalog:check": "node scripts/build-ios-catalog.js --check && node scripts/validate-ios-catalog.js",
    "ios:bundle:check": "node scripts/check-ios-bundle.js",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "ios:doctor": "cap doctor",
    "restaurant:rights": "node scripts/migrate-restaurant-rights.js",
    "validate": "node scripts/validate-data.js",
    "notify": "node scripts/notify.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit-dependencies.js",
    "check": "npm run lint && npm run test && npm run build && npm run audit",
    "release:check": "npm run check && npm run test:e2e && npm run catalog:check && node scripts/validate-data.js --strict"
  },
  "dependencies": {
    "@fontsource/josefin-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/calendar": "^1.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "astronomy-engine": "^2.1.19",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "puppeteer": "^25.8.0",
    "twilio": "^5.12.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
