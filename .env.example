# ── Required ──────────────────────────────────────────────────────────────────

# Your Notion integration token (starts with "secret_").
# Create one at: https://www.notion.so/my-integrations
# Make sure the integration has access to the Transcript Directory, CRM, and
# BlueBubbles database pages (share each page with the integration).
NOTION_API_KEY=secret_your_key_here

# ── BlueBubbles source (required for auto-sync) ───────────────────────────────

# The Notion database ID where BlueBubbles deposits raw messages.
# How to find it:
#   1. In Notion, search for your BlueBubbles inbox (common names: "Messages",
#      "iMessage Inbox", "BlueBubbles", or your contact's name).
#   2. Open the database → look at the URL:
#      https://www.notion.so/yourworkspace/<DATABASE_ID>?v=<view_id>
#   3. Paste the DATABASE_ID (32 hex chars) below.
#
# If BlueBubbles uses a page instead of a database, the script will need
# adjustment — open an issue or check the README for page-mode instructions.
BLUEBUBBLES_DB_ID=

# ── Optional ──────────────────────────────────────────────────────────────────

# The name used for Liza in BlueBubbles (case-insensitive partial match).
# Change this if her contact appears differently in the database.
LIZA_CONTACT_NAME=Liza

# Liza's phone number — used as a secondary filter if the name doesn't match.
# Include country code or not; non-digits are stripped before comparison.
LIZA_PHONE=
