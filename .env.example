# Toggl → Notion Sync — Environment Variables
# Copy this to .env and fill in your values
# Never commit .env to git

# Toggl API token — found at https://track.toggl.com/profile under "API token"
TOGGL_API_TOKEN=your_toggl_api_token_here

# Notion integration token — create one at https://www.notion.so/my-integrations
# Make sure the integration has access to your Time Log database
NOTION_TOKEN=secret_your_notion_token_here

# Notion Time Log database ID (pre-filled from task)
NOTION_DATABASE_ID=96e32d57-2333-4910-ba0c-6ff331cba6bc
