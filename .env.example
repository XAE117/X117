# SIXPM — environment variables template
# Copy this file to .env and fill in the values. .env is gitignored.
# Canonical secret storage: Notion → Codex Context Master → "x117 API Keys"

# The Movie Database v3 API key
# Used by: scripts/scrape.js for film enrichment (director, year, poster, rating, overview)
# Get one at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# AMC Theatres Developer API vendor key
# Used by: scripts/scrape.js scrapeAMCShowtimes() via X-AMC-Vendor-Key header
# Get one at: https://developers.amctheatres.com
AMC_API_KEY=

# Notion integration token (shared with iMessage pipeline)
# Get one at: https://www.notion.so/my-integrations
NOTION_API_KEY=

# Body Signals database used by morning-console.html
NOTION_BODY_SIGNALS_DATABASE_ID=01a5184fc8c340e0a0545ab4b0881585

# Shared access key required by the Morning Console API.
# Generate with: openssl rand -hex 32
MORNING_CONSOLE_SECRET=

# Toggl token used server-side for the Morning Console's seven-day effort readout.
TOGGL_API_TOKEN=

# Optional Morning Console overrides. Defaults point at the existing LifeOS sources.
NOTION_LIFE_PROJECTS_DATABASE_ID=d54d374d-bf65-4e52-955e-22138623388c
NOTION_ASTROLOGY_PAGE_ID=309c051d-73d2-8108-a5d6-cf4618a7e4cf
TOGGL_WORKSPACE_ID=20839628

# Optional build base override. Use "/" for Vercel/serverless deploys; omit for GitHub Pages.
VITE_BASE_PATH=

# Twilio credentials for Godfather SMS alert + weekly digest
# Get them at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TO_PHONE=
