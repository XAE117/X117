# Copy this to .env and fill in your Notion API key.
# The script lives at ~/Library/Messages/chat.db by default — no other config needed.

# Your Notion integration token (starts with "secret_")
# Create at: https://www.notion.so/my-integrations
# Share these pages with the integration:
#   - Liza Transcript Directory
#   - Liza CRM entry
#   - All week pages
NOTION_API_KEY=secret_your_key_here

# Optional overrides
# CHAT_DB_PATH=/path/to/chat.db   # only if chat.db is somewhere non-standard
