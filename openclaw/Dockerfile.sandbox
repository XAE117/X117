# =============================================================================
# OpenClaw Sandbox -- Stage 2
# =============================================================================
# Minimal container for agent code execution. Fully isolated:
#   - No network (network_mode: none in compose)
#   - Read-only rootfs
#   - Minimal toolchain (python3, sqlite3 for LifeOS DB access)
#
# Build:  docker build -t openclaw-sandbox:bookworm-slim -f Dockerfile.sandbox .
# =============================================================================
FROM debian:bookworm-slim

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        sqlite3 \
        ca-certificates \
        curl \
        jq \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Create sandbox user (unprivileged)
RUN useradd -m -s /bin/bash -u 1001 sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace

ENTRYPOINT ["tini", "--"]
CMD ["sleep", "infinity"]
