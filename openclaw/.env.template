# =============================================================================
# OpenClaw Environment Variables -- TEMPLATE
# =============================================================================
# Copy this to .env and fill in real values:
#   cp .env.template .env
#   chmod 600 .env
#
# NEVER commit .env to git. The .gitignore handles this.
# NEVER bake these values into Docker images.
# Rotate all keys immediately if you suspect exposure (see CVE-2026-25253).
# =============================================================================

# --- OpenClaw Gateway ---
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- LLM Provider ---
# Anthropic API key for Claude (primary LLM backend)
ANTHROPIC_API_KEY=

# --- Messaging Channels ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- Notion Integration (LifeOS hub) ---
# Two tokens for scoped access: read-write for active databases, read-only for reference databases.
# Create both at: https://www.notion.so/my-integrations
#
# RW integration: Enable "Read content", "Update content", "Insert content"
#   Share with: Projects, CRM, Daily Fuel Log, Time Tracking databases
NOTION_RW_TOKEN=
#
# RO integration: Enable only "Read content"
#   Share with: Ancient Paths, Operations Room databases
NOTION_RO_TOKEN=

# --- Google OAuth (Calendar + Gmail -- read-only) ---
# 1. Create a Google Cloud project at https://console.cloud.google.com
# 2. Enable the Google Calendar API and Gmail API
# 3. Create an OAuth 2.0 Client ID (Desktop app type)
# 4. Download the credentials JSON to credentials/google-oauth.keys.json
# 5. Run initial auth for each service (see mcp-config.md for details)
# Note: No env vars needed here -- OAuth files are bind-mounted from credentials/

# --- Optional: Additional LLM providers ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Optional: Additional messaging channels ---
# DISCORD_BOT_TOKEN=
# SIGNAL_CLI_REST_API_URL=
