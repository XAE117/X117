{
  "$schema": "https://docs.openclaw.ai/schema/config.json",

  "gateway": {
    "bind": "127.0.0.1",
    "port": 18789,
    "token": "${OPENCLAW_GATEWAY_TOKEN}",

    "security": {
      "wsOriginValidation": true,
      "corsAllowOrigins": ["http://127.0.0.1:18789"],
      "rateLimiting": {
        "enabled": true,
        "maxRequestsPerMinute": 60
      }
    }
  },

  "agents": {
    "lifeos": {
      "displayName": "LifeOS Agent",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-20250929",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "systemPrompt": "You are LifeOS, a personal life management assistant. You help track habits, fitness, finances, journal entries, goals, and dating contacts. You have access to Notion (Projects, CRM, Daily Fuel Log, Time Tracking for read/write; Ancient Paths and Operations Room for read-only), Google Calendar (read-only), and Gmail (read-only). Be concise and actionable in Telegram messages. Use short paragraphs and bullet points.",
      "workspace": "/workspace/lifeos",
      "sandbox": {
        "scope": "agent",
        "readOnlyRoot": true,
        "network": "none",
        "workspaceAccess": "rw"
      },

      "mcpServers": {
        "notion-rw": {
          "command": "npx",
          "args": ["-y", "@notionhq/notion-mcp-server"],
          "env": {
            "NOTION_TOKEN": "${NOTION_RW_TOKEN}"
          }
        },
        "notion-ro": {
          "command": "npx",
          "args": ["-y", "@notionhq/notion-mcp-server"],
          "env": {
            "NOTION_TOKEN": "${NOTION_RO_TOKEN}"
          }
        },
        "google-calendar": {
          "command": "npx",
          "args": ["-y", "@cocal/google-calendar-mcp"],
          "env": {
            "GOOGLE_OAUTH_CREDENTIALS": "/home/node/.credentials/google-oauth.keys.json",
            "ENABLED_TOOLS": "list-calendars,list-events,get-event,search-events,get-freebusy,get-current-time,list-colors"
          }
        },
        "gmail": {
          "command": "npx",
          "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
          "env": {
            "GMAIL_OAUTH_PATH": "/home/node/.credentials/google-oauth.keys.json",
            "GMAIL_CREDENTIALS_PATH": "/home/node/.credentials/gmail-token.json"
          }
        }
      }
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "agent": "lifeos",
      "allowedUsers": [],
      "webhook": {
        "enabled": false
      },
      "polling": {
        "enabled": true,
        "interval": 1000
      },
      "rateLimit": {
        "maxMessagesPerMinute": 30
      }
    }
  },

  "exec": {
    "approvals": {
      "mode": "always-prompt"
    },
    "sandbox": {
      "enabled": true,
      "capDrop": ["ALL"],
      "readOnlyRoot": true,
      "tmpfs": ["/tmp", "/var/tmp"],
      "memory": "1g",
      "pidsLimit": 256
    }
  },

  "logging": {
    "level": "info",
    "redactSecrets": true
  }
}
