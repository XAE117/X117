{
  "$schema": "https://docs.openclaw.ai/schema/config.json",

  "gateway": {
    "bind": "127.0.0.1",
    "port": 18789,
    "token": "${OPENCLAW_GATEWAY_TOKEN}",

    "security": {
      "wsOriginValidation": true,
      "corsAllowOrigins": ["http://127.0.0.1:18789"],
      "rateLimiting": {
        "enabled": true,
        "maxRequestsPerMinute": 60
      }
    }
  },

  "agents": {
    "lifeos": {
      "displayName": "LifeOS Agent",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-20250929",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "systemPrompt": "You are LifeOS, a personal life management assistant. You help track habits, fitness, finances, journal entries, goals, and dating contacts. Be concise and actionable in Telegram messages. Use short paragraphs and bullet points.",
      "workspace": "/workspace/lifeos",
      "sandbox": {
        "scope": "agent",
        "readOnlyRoot": true,
        "network": "none",
        "workspaceAccess": "rw"
      }
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "agent": "lifeos",
      "allowedUsers": [],
      "webhook": {
        "enabled": false
      },
      "polling": {
        "enabled": true,
        "interval": 1000
      },
      "rateLimit": {
        "maxMessagesPerMinute": 30
      }
    }
  },

  "exec": {
    "approvals": {
      "mode": "always-prompt"
    },
    "sandbox": {
      "enabled": true,
      "capDrop": ["ALL"],
      "readOnlyRoot": true,
      "tmpfs": ["/tmp", "/var/tmp"],
      "memory": "1g",
      "pidsLimit": 256
    }
  },

  "logging": {
    "level": "info",
    "redactSecrets": true
  }
}
